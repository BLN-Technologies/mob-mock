# Cargo V1 Mobile Environment Configuration Template
# Do not commit real production secrets or API keys.

# API Base URL (Future NestJS Backend)
EXPO_PUBLIC_API_URL=https://api.cargo.rw/v1

# Environment Mode
EXPO_PUBLIC_APP_ENV=demo # Options: demo, staging, production

# Sentry / Error Tracking (Optional)
EXPO_PUBLIC_SENTRY_DSN=
